var twoSum = function(nums, target) {
     let left = 0;
     let right = nums.length - 1;
       if(!nums.length) return []
     while(left < right) {
        const sum = nums[left] + nums[right];
        if(sum == target) {
            return [left + 1 , right + 1]
        }
         if(sum > target) {
            right--;
        }
         if(sum < target) {
            left++;
        }
     }
};
